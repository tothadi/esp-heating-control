# ESP Heating Control - "Thread/Matter mode" firmware for the ESP32-S3-WROOM-1-N16R8 (16 MB quad flash,
# 8 MB octal PSRAM). ESP-IDF v5.5.5 + esp-matter release/v1.6 (9f2e35ac) + esp_rcp_update (esp-thread-br v1.3).
# Based on esp-matter examples/controller (sdkconfig.defaults + sdkconfig.defaults.otbr) and ESP-IDF ot_br.
CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_COMPILER_OPTIMIZATION_SIZE=y

# Partition table
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_OFFSET=0x8000

# Console / logs on the S3's USB-Serial/JTAG (USB-C "MAIN"); UART0 (IO43/44) is not connected
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y

# PSRAM: 8 MB octal (IO35-IO37 belong to it). Heaps, BSS of the big libraries, Wi-Fi/lwIP, NimBLE, mbedTLS and
# Matter allocations go to PSRAM to keep internal RAM free.
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=512
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=32768
CONFIG_SPIRAM_ALLOW_BSS_SEG_EXTERNAL_MEMORY=y
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
CONFIG_BT_NIMBLE_MEM_ALLOC_MODE_EXTERNAL=y
CONFIG_ESP_MATTER_MEM_ALLOC_MODE_EXTERNAL=y
CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=y
CONFIG_OPENTHREAD_PLATFORM_MALLOC_CAP_SPIRAM=y
CONFIG_OPENTHREAD_PLATFORM_MSGPOOL_MANAGEMENT=y

# Bluetooth LE (NimBLE): Matter commissioning (PASE over BLE). Kept up after commissioning.
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_ENABLE_ESP32_BLE_CONTROLLER=y
CONFIG_USE_BLE_ONLY_FOR_COMMISSIONING=n

# Matter: controller + commissioner, no Matter server (the device itself is not a Matter node)
CONFIG_ENABLE_CHIP_CONTROLLER_BUILD=y
CONFIG_ESP_MATTER_CONTROLLER_ENABLE=y
CONFIG_ESP_MATTER_COMMISSIONER_ENABLE=y
CONFIG_ESP_MATTER_ENABLE_MATTER_SERVER=n
CONFIG_ESP_MATTER_CONTROLLER_CUSTOM_CLUSTER_ENABLE=n
# Production devices: PAA roots from the CSA DCL (needs Internet during commissioning); test devices still work.
CONFIG_DCL_ATTESTATION_TRUST_STORE=y
CONFIG_ESP_MATTER_COMMISSIONER_SUPPORT_TEST_CD=y
CONFIG_WIFI_NETWORK_COMMISSIONING_DRIVER=n
CONFIG_THREAD_NETWORK_COMMISSIONING_DRIVER=n
CONFIG_SUPPORT_GROUPCAST_CLUSTER=n
CONFIG_BUILD_CHIP_TESTS=n
CONFIG_ENABLE_OTA_REQUESTOR=n
CONFIG_CHIP_PROJECT_CONFIG="main/matter_project_config.h"
CONFIG_NUM_UDP_ENDPOINTS=16
CONFIG_ENABLE_CHIP_SHELL=y
CONFIG_ESP_MATTER_CONSOLE_TASK_STACK=6144
CONFIG_CHIP_SHELL_CMD_LINE_BUF_MAX_LENGTH=512
CONFIG_CHIP_TASK_STACK_SIZE=15360
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=4096
CONFIG_MBEDTLS_HKDF_C=y
CONFIG_ENABLE_WIFI_STATION=y
CONFIG_ENABLE_WIFI_AP=n
# The OpenThread border router installs the route hook
CONFIG_ENABLE_ROUTE_HOOK=n
CONFIG_USE_MINIMAL_MDNS=n
CONFIG_ENABLE_EXTENDED_DISCOVERY=y
CONFIG_MDNS_MULTIPLE_INSTANCE=y

# OpenThread border router, H2 RCP on UART1 (S3 IO10 TX -> H2 RXD0, S3 IO11 RX <- H2 TXD0, 460800 baud)
CONFIG_OPENTHREAD_ENABLED=y
CONFIG_OPENTHREAD_BORDER_ROUTER=y
CONFIG_OPENTHREAD_RADIO_SPINEL_UART=y
CONFIG_OPENTHREAD_LOG_LEVEL_DYNAMIC=n
CONFIG_OPENTHREAD_LOG_LEVEL_NOTE=y
CONFIG_OPENTHREAD_SRP_CLIENT=n
CONFIG_OPENTHREAD_DNS_CLIENT=n
CONFIG_OPENTHREAD_TASK_SIZE=8192
CONFIG_THREAD_TASK_STACK_SIZE=8192
CONFIG_MBEDTLS_CMAC_C=y
CONFIG_MBEDTLS_KEY_EXCHANGE_ECJPAKE=y
CONFIG_MBEDTLS_ECJPAKE_C=y
CONFIG_MBEDTLS_SSL_PROTO_DTLS=y

# RCP auto-update: the H2 image (../h2-rcp) is packed into the rcp_fw SPIFFS partition at build time
# (CONFIG_RCP_SRC_DIR is set by CMakeLists.txt) and flashed into the H2 (EN = IO12, BOOT = IO13) when it differs.
CONFIG_AUTO_UPDATE_RCP=y
CONFIG_RCP_PARTITION_NAME="rcp_fw"

# lwIP for the border router (Wi-Fi or Ethernet backbone)
CONFIG_LWIP_IPV6_FORWARD=y
CONFIG_LWIP_IPV6_NUM_ADDRESSES=12
CONFIG_LWIP_MULTICAST_PING=y
CONFIG_LWIP_NETIF_STATUS_CALLBACK=y
CONFIG_LWIP_HOOK_IP6_ROUTE_DEFAULT=y
CONFIG_LWIP_HOOK_ND6_GET_GW_DEFAULT=y
CONFIG_LWIP_IPV6_AUTOCONFIG=y

# Ethernet: WIZnet W5500 on SPI (SCK IO39, MOSI IO40, MISO IO41, CS IO42, INT IO38)
CONFIG_ETH_ENABLED=y
CONFIG_ETH_USE_SPI_ETHERNET=y
CONFIG_ETH_SPI_ETHERNET_W5500=y
CONFIG_MDNS_PREDEF_NETIF_ETH=y

# MQTT settings/state interface, SNTP
CONFIG_MQTT_PROTOCOL_311=y
CONFIG_LWIP_SNTP_MAX_SERVERS=2

# esp_rcp_update default pins (also set explicitly in main/hc_thread.cpp): S3 IO11 <- H2 TX, IO10 -> H2 RX,
# IO12 -> H2 EN, IO13 -> H2 BOOT (GPIO9)
CONFIG_DEFAULT_PIN_TO_RCP_TX=11
CONFIG_DEFAULT_PIN_TO_RCP_RX=10
CONFIG_DEFAULT_PIN_TO_RCP_RESET=12
CONFIG_DEFAULT_PIN_TO_RCP_BOOT=13
